{
  "name": "purrge",
  "version": "0.4.0",
  "description": "Cough up the build artifacts your stale projects are sitting on",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "purrge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "purrge.config.example.json",
    "purrge.config.example.yml"
  ],
  "keywords": [
    "cleanup",
    "disk-space",
    "node_modules",
    "bun",
    "cli",
    "gum",
    "cargo",
    "tauri",
    "git-worktree",
    "ios-simulator",
    "android-emulator",
    "xcode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvanhouts/purrge.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "start": "bun run src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
